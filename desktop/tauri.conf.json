{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HushUp",
  "mainBinaryName": "HushUp",
  "identifier": "io.github.hushup.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HushUp",
        "width": 420,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nguyễn Thanh Phú",
    "shortDescription": "Stop OS updates and silence the update nags",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
